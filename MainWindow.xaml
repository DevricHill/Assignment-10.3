<Window x:Class="Assignment_10._3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment_10._3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DataGrid x:Name="carGrid" Grid.Column="0" Margin="5" AutoGenerateColumns="True"/>

        <!-- Form -->

        <StackPanel Grid.Column="1">
            <Label Content="VIN"/>
            <TextBox x:Name="txtVIN"/>

            <Label Content="Make"/>
            <TextBox x:Name="txtMake"/>

            <Label Content="Model"/>
            <TextBox x:Name="txtModel"/>

            <Label Content="Year"/>
            <TextBox x:Name="txtYear"/>

            <Label Content="Price"/>
            <TextBox x:Name="txtPrice"/>

            <WrapPanel Margin="0, 20, 0, 0">
                <Button x:Name="btnAddNew" Width="90" Margin="5" Content="Add New" Click="btnAddNew_Click"/>
                <Button x:Name="btnSubmit" Width="90" Margin="5" Content="Submit" Click="btnSubmit_Click"/>
                <Button x:Name="btnSelect" Width="90" Margin="5" Content="Select" Click="btnSelect_Click"/>
                <Button x:Name="btnDelete" Width="90" Margin="5" Content="Delete" Click="btnDelete_Click"/>
                <Button x:Name="btnUpdate" Width="90" Margin="5" Content="Update" Click="btnUpdate_Click"/>

            </WrapPanel>

        </StackPanel>

    </Grid>
</Window>
